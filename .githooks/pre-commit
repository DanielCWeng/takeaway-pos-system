#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

PRETTIER_BIN=""
if [ -x "server/node_modules/.bin/prettier" ]; then
  PRETTIER_BIN="server/node_modules/.bin/prettier"
elif [ -x "client/node_modules/.bin/prettier" ]; then
  PRETTIER_BIN="client/node_modules/.bin/prettier"
elif command -v prettier >/dev/null 2>&1; then
  PRETTIER_BIN="prettier"
else
  echo "pre-commit: Prettier not found. Install dependencies in client/ or server/ first."
  exit 1
fi

staged_files=()
while IFS= read -r -d '' file; do
  case "$file" in
    *.js|*.jsx|*.ts|*.tsx|*.cjs|*.mjs|*.json|*.md|*.css|*.scss|*.html|*.yml|*.yaml)
      if [ -f "$file" ]; then
        staged_files+=("$file")
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "${#staged_files[@]}" -eq 0 ]; then
  exit 0
fi

echo "pre-commit: formatting staged files with Prettier..."
"$PRETTIER_BIN" --write "${staged_files[@]}"
git add -- "${staged_files[@]}"
