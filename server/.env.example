# ============================================================
# Takeaway POS — Server Environment Configuration
# Copy this file to .env and fill in the values.
# The server will refuse to start if any required var is missing.
# ============================================================

# --- Server ---
PORT=4000
# Allowed origin for CORS (frontend URL)
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Path to the SQLite orders database (created automatically)
DB_PATH=./data/orders.db

# Path to the read-only postcodes validation database
POSTCODES_DB_PATH=./data/postcodes.db

# --- Address API (getaddress.io) ---
# Required for address lookup and distance calculation.
# Leave blank to run in degraded mode (no address enrichment).
GETADDRESS_API_KEY=

# UK postcode for the store (used to calculate delivery distances)
STORE_POSTCODE=NG9 8GF

# Store coordinates — used for delivery radius calculation (WGS84 decimal degrees)
STORE_LATITUDE=
STORE_LONGITUDE=

# --- Printer (USB ESC/POS) ---
# USB Vendor ID for the thermal printer (hex, e.g. 0x154f)
PRINTER_VENDOR_ID=0x154f
# USB Product ID for the thermal printer (hex, e.g. 0x154f)
PRINTER_PRODUCT_ID=0x154f

# --- Caller ID Device ---
# HID device path. Leave blank for auto-detection.
CALLER_DEVICE_PATH=

# --- TAPI / CTI Bridge ---
# Set to 0 to disable the TAPI bridge integration.
TAPI_BRIDGE_PORT=8765
# Optional override path to TapiBridge.exe (absolute or relative to repo root).
TAPI_BRIDGE_EXE_PATH=
# Optional shared secret used for localhost DIAL commands.
# When set, both server and bridge must use the same value.
TAPI_BRIDGE_TOKEN=

# --- Business Rules ---
DELIVERY_BASE_CHARGE=2.00
DELIVERY_DISTANCE_THRESHOLD_MILES=2
DELIVERY_RATE_PER_MILE=0.50
ORDER_AUTO_RELOAD_COUNT=3
ORDER_AUTO_CLEANUP_MINUTES=5
MAX_CONCURRENT_ORDERS=9
# Number of years to keep order history before automatic deletion (GDPR compliance)
DATA_RETENTION_YEARS=6
# Bearer token required for privileged GDPR/admin endpoints (export, erase, retention cleanup)
# Keep this value in sync with client VITE_ADMIN_API_TOKEN.
ADMIN_API_TOKEN=change-me
# Global API rate limiting (per IP)
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=600
API_RATE_LIMIT_MAX_BUCKETS=5000
# Additional brute-force protection for admin token failures (per IP)
ADMIN_AUTH_FAILURE_WINDOW_MS=60000
ADMIN_AUTH_FAILURE_MAX_ATTEMPTS=25
ADMIN_AUTH_FAILURE_MAX_BUCKETS=2000
# Only enable when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# --- Logging ---
# One of: error | warn | info | debug
LOG_LEVEL=info

# --- WebSocket ---
# Heartbeat interval (ms)
WS_HEARTBEAT_MS=30000
