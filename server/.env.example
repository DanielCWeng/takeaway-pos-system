# ============================================================
# Takeaway POS — Server Environment Configuration
# Copy this file to .env and fill in the values.
# The server will refuse to start if any required var is missing.
# ============================================================

# --- Server ---
PORT=4000
# Allowed origin for CORS (frontend URL)
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Path to the SQLite orders database (created automatically)
DB_PATH=./data/orders.db

# Path to the read-only postcodes validation database
POSTCODES_DB_PATH=./data/postcodes.db

# --- Address API (getaddress.io) ---
# Required for address lookup and distance calculation.
# Leave blank to run in degraded mode (no address enrichment).
GETADDRESS_API_KEY=

# UK postcode for the store (used to calculate delivery distances)
STORE_POSTCODE=NG9 8GF

# Store coordinates — used for delivery radius calculation (WGS84 decimal degrees)
STORE_LATITUDE=
STORE_LONGITUDE=

# --- Printer (USB ESC/POS) ---
# USB Vendor ID for the thermal printer (hex, e.g. 0x154f)
PRINTER_VENDOR_ID=0x154f
# USB Product ID for the thermal printer (hex, e.g. 0x154f)
PRINTER_PRODUCT_ID=0x154f

# --- Caller ID Device ---
# HID device path. Leave blank for auto-detection.
CALLER_DEVICE_PATH=

# --- Business Rules ---
DELIVERY_BASE_CHARGE=2.00
DELIVERY_DISTANCE_THRESHOLD_MILES=2
DELIVERY_RATE_PER_MILE=0.50
ORDER_AUTO_RELOAD_COUNT=3
ORDER_AUTO_CLEANUP_MINUTES=5
MAX_CONCURRENT_ORDERS=9

# --- Logging ---
# One of: error | warn | info | debug
LOG_LEVEL=info

# --- WebSocket ---
# Heartbeat interval (ms)
WS_HEARTBEAT_MS=30000
