{
  "name": "takeaway-pos-server",
  "version": "1.0.0",
  "description": "Takeaway POS System — Backend Server (Phase 1)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/ scripts/",
    "lint:fix": "eslint src/ tests/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "node scripts/migrate.js",
    "db:seed-postcodes": "node scripts/seedPostcodes.js",
    "caller-id:diagnose": "node scripts/diagnoseCallerId.js",
    "caller-id:listen": "node scripts/diagnoseCallerId.js --listen",
    "contacts:import-bt": "node scripts/importBtContacts.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "canvas": "^3.2.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "lru-cache": "^11.2.7",
    "node-hid": "^3.2.0",
    "proj4": "^2.20.4",
    "usb": "^2.15.0",
    "ws": "^8.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n": "^17.9.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
